.wrapper { min-height: 100vh; padding: 4.5rem 1.5rem 3rem; color: #f8fafc; background: #0f172a; }
.content { width: min(1100px, 100%); margin: 0 auto; display: grid; gap: 1.5rem; }
.hero, .settlement { padding: 1.5rem; border: 1px solid #475569; border-radius: 20px; background: #1e293b; }
.hero { text-align: center; }
.hero h1, .settlement h2 { margin: .25rem 0 .5rem; }
.hero p, .settlement p { margin: 0; color: #cbd5e1; }
.eyebrow { text-transform: uppercase; letter-spacing: .14rem; font-size: .8rem; font-weight: 700; }
.worldImage { width: 100%; max-height: 460px; object-fit: cover; border-radius: 20px; border: 1px solid #64748b; }
.grid, .shopGrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; }
.settlementView { width: min(1200px, 100%); margin: 0 auto; padding-top: 1rem; }
.settlementView h1 { margin: 0 0 1.5rem; text-align: center; }
.cardButton, .shopButton { overflow: hidden; padding: 0; border: 1px solid #64748b; border-radius: 15px; color: #f8fafc; background: #334155; cursor: pointer; font: 700 1rem Georgia, serif; }
.cardButton:hover, .cardButton:focus-visible, .shopButton:hover, .shopButton:focus-visible { border-color: #bfdbfe; transform: translateY(-2px); }
.cardButton img, .shopButton img { display: block; width: 100%; height: 160px; object-fit: contain; background: rgba(255, 255, 255, .85); }
.cardButton span, .shopButton span { display: block; padding: .85rem; }
.settlement { display: grid; grid-template-columns: 220px 1fr; gap: 1.25rem; }
.settlement > img { width: 100%; border-radius: 14px; }
.shopGrid { grid-column: 1 / -1; }
.backButton { position: fixed; z-index: 2; top: 1rem; left: 1rem; padding: .7rem 1rem; border: 0; border-radius: 10px; font-weight: 700; cursor: pointer; }
@media (max-width: 600px) { .settlement { grid-template-columns: 1fr; } }
